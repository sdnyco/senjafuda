{
  "name": "senjafuda",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-prod-config.mjs",
    "build": "node scripts/migrate-on-build.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "data:export": "tsx scripts/export.ts",
    "check:prod-config": "node scripts/check-prod-config.mjs",
    "test": "tsx --test src/lib/canvas-growth.test.ts"
