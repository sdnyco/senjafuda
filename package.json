    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
