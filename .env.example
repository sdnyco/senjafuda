# Local/dev: use a Neon *dev* branch URL — never production.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL_READONLY=postgresql://senjafuda_export:pass@host/db?sslmode=require
# Fixed salt for public_id (Vercel Production + Preview + Actions). Never rotate in Production.
EXPORT_ID_SALT=replace-with-long-random-string
# HMAC for signed write links (different values for Production and Preview).
# openssl rand -hex 32
LINK_SIGNING_SECRET=replace-with-at-least-32-random-bytes-hex
# Preview-only test hooks (never set in Production).
# TEST_HOOK_SECRET=
# Required for seed: must equal the host of DATABASE_URL exactly (no credentials).
# SEED_CONFIRM_HOST=ep-xxxx.region.aws.neon.tech
# Optional on Preview: same value as production DATABASE_URL so a misconfigured
# preview that points at prod fails closed (see docs/deploy.md).
# PRODUCTION_DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
IP_HASH_PEPPER=replace-with-long-random-string
GITHUB_DATA_URL=https://github.com/OWNER/REPO/tree/main/data
# Canonical public origin. Also required as a GitHub Actions secret for the
# nightly export job (Internet Archive saves of / and /record).
SITE_ORIGIN=https://senjafuda.org
